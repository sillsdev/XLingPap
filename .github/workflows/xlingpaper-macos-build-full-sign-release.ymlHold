# This workflow will build an installer for XLingPaper full, sign and notarize it

name: XLingPaper macOS Sign Full Build Installer with Version
#################################################################
#
# NOTE: we need to install the XMLmind XML Editor version 8.2 but
#       it was built with Java 8.  Apple no longer allows notarization
#       for Java 8 applications.
#       Therefore we cannot sign and notarize this installer.
#       (May 28, 2026)
#
#################################################################
on:
  push:
    tags:
      - 'v*'  # Build the app for commits that are tagged starting with 'v' e.g. v1.2.3
#       #to tag a commit, use "git tag v1.2.3"
#       #when you then use "git push origin v1.2.3" this workflow will be invoked
#  workflow_dispatch:

jobs:
  build-installer:
    runs-on: macos-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: '0'

      - name: Set and validate version
        uses: ./.github/actions/set-validate-version

      # If a notarization fails, uncomment the following and replace the GUID with the one from
      # notarization output
      # Get notarization log of last run
      - name: Get notarization log
        run: |
          echo Before trying to get notarization log of last run
          xcrun notarytool log 6a4548b5-fda5-4723-9d37-de848a79fa82 --apple-id ${{ secrets.SIL_APPLE_NOTARIZATION_USERNAME }} --team-id "3YE4W86L3G" --password ${{ secrets.SIL_APPLE_NOTARIZATION_PASSWORD }}

# macOS does not allow for JDK 8 and we need it for building XLingPap.jar in order not to block XXE 8.2 from running.
# Since XLingPap.jar comes with the configuration files and is platform-independant, we'll just use it for macOS.
#      - name: 'Prepare for Java compilation'
#        run: |
#          cd javasrc/XLingPapExtensions
#          mkdir class
#          mkdir XXEJars
#          cd XXEJars
#          7z x ../../../installers/XXE8Jars/XXE8Jars.7z -p${{ secrets.XXE82_INSTALLER }}
#
#      - name: Set up JDK 8
#        uses: actions/setup-java@v4
#        with:
#          java-version: '8'
#          distribution: 'temurin'
#          java-package: 'jdk'
#
#      - name: Build with Ant
#        run: |
#          cd javasrc/XLingPapExtensions
#          ant -noinput -buildfile build.xml
#        shell: bash

      - name: 'create XLingPaper Configuration Folder'
        uses:  ./.github/actions/macos-create-xlp-config-folder

      - name: Install Packages CLI
        uses:  ./.github/actions/macos-install-packages

      - name: Add certificate to Keychain
        env:
          MACOS_CERTIFICATE: ${{ secrets.MACOS_CERTIFICATE }}
          MACOS_CERTIFICATE_PWD: ${{ secrets.SIL_APPLE_DEVELOPER_ID_APPLICATION_PASSWORD }}
          KEYCHAIN_PASSWORD: ${{ secrets.SIL_APPLE_DEVELOPER_ID_APPLICATION_PASSWORD }}
        run: |
          # Create a temporary keychain
          security create-keychain -p "$KEYCHAIN_PASSWORD" build.keychain
          security default-keychain -s build.keychain
          security unlock-keychain -p "$KEYCHAIN_PASSWORD" build.keychain

          # Import the developer certificate
          curl -O ${{ secrets.SIL_APPLE_DEVELOPER_ID_APPLICATION_CERT_URL }}
          security import sil_developer_id_application_cert.p12 -k build.keychain -P ${{ secrets.SIL_APPLE_DEVELOPER_ID_APPLICATION_PASSWORD }} -T /usr/bin/codesign

          # Allow codesign to access the certificate without prompts
          #echo before allow codesign to access the certificate without prompts
          security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k "$KEYCHAIN_PASSWORD" build.keychain
          #echo after allow codesign to access the certificate without prompts

          # Import the installer certificate
          curl -O ${{ secrets.SIL_APPLE_DEVELOPER_ID_INSTALLER_CERT_URL }}
          echo before import istaller
          ls -l
          security import sil_developer_id_installer_cert.p12 -k build.keychain -P ${{ secrets.SIL_APPLE_DEVELOPER_ID_INSTALLER_PASSWORD }} -T /usr/bin/productsign

          # Allow productsign to access the certificate without prompts
          #echo before allow codesign to access the certificate without prompts
          security set-key-partition-list -S apple-tool:,apple:,productsign: -s -k "$KEYCHAIN_PASSWORD" build.keychain
          #echo after allow codesign to access the certificate without prompts

      - name: Create Clean Entitlements File
        run: |
          cat <<EOF > installers/macos/entitlements.plist
          <?xml version="1.0" encoding="UTF-8"?>
          <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
          <plist version="1.0">
          <dict>
              <key>com.apple.security.cs.allow-jit</key>
              <true/>
              <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
              <true/>
              <key>com.apple.security.cs.disable-library-validation</key>
              <true/>
          </dict>
          </plist>
          EOF
        shell: bash

      - name: Build .pkg Installer
        run: |
          # Navigate to the directory containing the .pkgproj file
          cd installers/macos/XLingPaperFullMacros
          chmod a+x *.sh
          cd ../XLingPaperFullSetupXXEPersoCatalina
          sed -i '' "s/3.18.0/${{ env.VERSION }}/" ReadMe.rtf
          sed -i '' "s/3.18.0/${{ env.VERSION }}/" XLingPaperFullSetupXXEPersoCatalina.pkgproj
          cd ..
          pwd
          7z x XMLmindMac.7z -p${{ secrets.XXE82_INSTALLER }}
          ls -l

          # -------------  sign all JavaFX runtime executables included in the app
          # without this, the notarization fails.
          # For some reason, there are two libjli.dylib files; notarization has a problem with this
          # Find all .dylib files and sign them
          # {} is a placeholder for the filename
          # + at the end is faster as it passes multiple files to one command
          echo try to sign dylib files
          find XMLmind.app/Contents/Resources/xxe/bin/jre/lib -name "*.dylib" -exec \
            codesign --force --sign "${{ vars.SIL_APPLE_CODESIGN_IDENTITY }}" \
            --timestamp --options runtime --entitlements entitlements.plist \
            {} +
          echo try to sign jre bin files
          find XMLmind.app/Contents/Resources/xxe/bin/jre/bin -name "*.*" -exec \
            codesign --force --sign "${{ vars.SIL_APPLE_CODESIGN_IDENTITY }}" \
            --timestamp --options runtime --entitlements entitlements.plist \
            {} +
          echo after signing jre bin files

          7z x texlive2020macOs.7z -p${{ secrets.XXE82_INSTALLER }}
          ls -l
          cd XLingPaperFullSetupXXEPersoCatalina
          pwd
          packagesbuild --project XLingPaperFullSetupXXEPersoCatalina.pkgproj --package-version ${{ env.VERSION }}
          pwd
          ls -l
          ls -l build
          cd build
          productsign --sign "${{ vars.SIL_APPLE_DEVELOPER_ID_INSTALLER_CODESIGN_IDENTITY }}" \
             XLingPaperFullSetupXXEPersoCatalina-${{ env.VERSION }}.pkg \
             XLingPaperConfigurationFiles7n8-3.16.0Signed.pkg

      # Verify the signature
      - name: Verify signature
        run: |
          echo dir of installers/macos/XLingPaperFullSetupXXEPersoCatalina
          cd installers/macos/XLingPaperFullSetupXXEPersoCatalina/
          ls -lR
          pkgutil --check-signature build/XLingPaperConfigurationFiles7n8-3.16.0Signed.pkg

      - name: Create DMG with hdiutil
        run: |
          # Create a folder to hold the DMG contents
          cd installers/macos/XLingPaperFullSetupXXEPersoCatalina/build
          mkdir -p dmg_root
          cp XLingPaperFullSetupXXEPersoCatalina-*.pkg dmg_root/

          # Create the DMG
          # -volname: The name shown when the DMG is mounted
          # -srcfolder: The source directory
          # -ov: Overwrite existing file
          # -format: UDZO is the standard compressed format
          hdiutil create -volname "XLingPaper Full Setup Installer" \
                         -srcfolder dmg_root \
                         -ov -format UDZO \
                         XLingPaper-3.18.3FullSetupXXEPersoCatalina.dmg
          cd ..
          pwd
          ls -lR

      - uses: actions/upload-artifact@v4
        with:
          name: XLingPaperFull
          path: installers/macos/XLingPaperFullSetupXXEPersoCatalina/build/XLingPaper-*FullSetupXXEPersoCatalina.dmg
          if-no-files-found: error

#      # Clean up keychain
#      - name: Clean up keychain
#        if: always()
#        run: |
#          security delete-keychain build.keychain || true

     # Notarize the DMG
      - name: Notarize DMG
        uses: lando/notarize-action@v2
        with:
          product-path: installers/macos/XLingPaperFullSetupXXEPersoCatalina/build/XLingPaper-3.18.3FullSetupXXEPersoCatalina.dmg
          appstore-connect-username: ${{ secrets.SIL_APPLE_NOTARIZATION_USERNAME }}
          appstore-connect-password: ${{ secrets.SIL_APPLE_NOTARIZATION_PASSWORD }}
          appstore-connect-team-id: "3YE4W86L3G"
          verbose: true
#          appstore-connect-team-id: ${{ secrets.APPLE_TEAM_ID }}

      # Staple the notarization ticket
      - name: Staple Notarization Ticket
        run: |
          #echo before stapling
          xcrun stapler staple installers/macos/XLingPaperFullSetupXXEPersoCatalina/build/XLingPaper-3.18.3FullSetupXXEPersoCatalina.dmg
          #echo after stapling
          cd installers/macos/XLingPaperFullSetupXXEPersoCatalina/build
          #echo rename to include version number
          cp XLingPaper-3.18.3FullSetupXXEPersoCatalina.dmg XLingPaper-${{ env.VERSION }}FullSetupXXEPersoCatalina.dmg
          rm XLingPaper-3.18.3FullSetupXXEPersoCatalina.dmg

      - uses: actions/upload-artifact@v4
        with:
          name: XLingPaperConfigSigned
          path: installers/macos/XLingPaperFullSetupXXEPersoCatalina/build/XLingPaper-*FullSetupXXEPersoCatalina.dmg
          if-no-files-found: error

  create-release:
    name: Create Release
    needs: build-installer
    runs-on: macos-latest
    steps:
      - uses: actions/download-artifact@v4
        with:
          name: XLingPaperFull

      - name: Check dmg
        run: |
          echo Before release
          ls -lR *.dmg

      - name: Create Release
        uses: softprops/action-gh-release@v2
        with:
          files: XLingPaper-*FullSetupXXEPersoCatalina.dmg
          body: |
            Release for version ${{ github.ref }}
          draft: true
